        ...ReplShieldTokenRow_record
      }
    }
    ... on UserError {
      message
    }
    ... on NotFoundError {
      message
    }
    ... on UnauthorizedError {
      message
    }
  }
}
    ${a}`,u=n.gql`
    mutation RevokeReplShieldToken($input: RevokeReplShieldTokenInput!) {
