      hostingDeployment {
        ... on HostingDeployment {
          id
          currentBuild {
            id
            rollbackSourceBuildId
            envVars {
              name
              value
            }
          }
          activityLogs(after: $after, count: $count) {
            items {
              ...HostingActivityLogLine2
            }
            pageInfo {
              hasNextPage
              nextCursor
            }
          }
        }
        ... on Error {
          message
        }
      }
    }
    ... on Error {
      message
    }
  }
}
