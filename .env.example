# Root workspace example configuration

# Gemini AI Integration
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_INTEGRATIONS_GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/corrigo

# Node Environment
NODE_ENV=development

# API Server
API_PORT=5001
API_HOST=localhost

# Frontend
VITE_API_URL=http://localhost:5001

# Logging
LOG_LEVEL=info

# DataDog (Optional)
DATADOG_ENABLED=false
DATADOG_API_KEY=
DATADOG_APP_KEY=

# Sentry (Optional)
SENTRY_DSN=